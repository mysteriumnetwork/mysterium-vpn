CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/WireGuardKit" "${PODS_CONFIGURATION_BUILD_DIR}/mail_launcher" "${PODS_CONFIGURATION_BUILD_DIR}/openvpn_dart" "${PODS_CONFIGURATION_BUILD_DIR}/wireguard_dart" "${PODS_ROOT}/WireGuardKit/Frameworks"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/WireGuardKit/WireGuardKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/mail_launcher/mail_launcher.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/openvpn_dart/openvpn_dart.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/wireguard_dart/wireguard_dart.framework/Headers" "${PODS_XCFRAMEWORKS_BUILD_DIR}/WireGuardKit/Headers"
OTHER_LDFLAGS = $(inherited) -framework "WireGuardKit" -framework "mail_launcher" -framework "openvpn_dart" -framework "wireguard_dart"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
