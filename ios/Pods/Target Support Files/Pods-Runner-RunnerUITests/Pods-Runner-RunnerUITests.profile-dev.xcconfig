ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/WireGuardKit" "${PODS_CONFIGURATION_BUILD_DIR}/mail_launcher" "${PODS_CONFIGURATION_BUILD_DIR}/openvpn_dart" "${PODS_CONFIGURATION_BUILD_DIR}/wireguard_dart" "${PODS_ROOT}/WireGuardKit/Frameworks"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/WireGuardKit/WireGuardKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/mail_launcher/mail_launcher.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/openvpn_dart/openvpn_dart.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/wireguard_dart/wireguard_dart.framework/Headers" "${PODS_XCFRAMEWORKS_BUILD_DIR}/WireGuardKit/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift "$(PLATFORM_DIR)/Developer/Library/Frameworks" '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_XCFRAMEWORKS_BUILD_DIR}/WireGuardKit" "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -framework "WireGuardKit" -framework "mail_launcher" -framework "openvpn_dart" -framework "wireguard_dart"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Flutter" "-F${PODS_CONFIGURATION_BUILD_DIR}/WireGuardKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/mail_launcher" "-F${PODS_CONFIGURATION_BUILD_DIR}/openvpn_dart" "-F${PODS_CONFIGURATION_BUILD_DIR}/wireguard_dart"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
