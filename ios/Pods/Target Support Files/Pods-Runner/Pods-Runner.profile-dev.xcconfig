ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
APPLICATION_EXTENSION_API_ONLY = YES
CLANG_CXX_LANGUAGE_STANDARD = gnu++14
CLANG_CXX_LIBRARY = libc++
CLANG_WARN_DOCUMENTATION_COMMENTS = NO
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/OpenVPNAdapter" "${PODS_CONFIGURATION_BUILD_DIR}/WireGuardKit" "${PODS_CONFIGURATION_BUILD_DIR}/mail_launcher" "${PODS_CONFIGURATION_BUILD_DIR}/openvpn_dart" "${PODS_CONFIGURATION_BUILD_DIR}/wireguard_dart" "${PODS_ROOT}/OneSignalXCFramework/iOS_SDK/OneSignalSDK/OneSignal_Core" "${PODS_ROOT}/OneSignalXCFramework/iOS_SDK/OneSignalSDK/OneSignal_Extension" "${PODS_ROOT}/OneSignalXCFramework/iOS_SDK/OneSignalSDK/OneSignal_InAppMessages" "${PODS_ROOT}/OneSignalXCFramework/iOS_SDK/OneSignalSDK/OneSignal_LiveActivities" "${PODS_ROOT}/OneSignalXCFramework/iOS_SDK/OneSignalSDK/OneSignal_Location" "${PODS_ROOT}/OneSignalXCFramework/iOS_SDK/OneSignalSDK/OneSignal_Notifications" "${PODS_ROOT}/OneSignalXCFramework/iOS_SDK/OneSignalSDK/OneSignal_OSCore" "${PODS_ROOT}/OneSignalXCFramework/iOS_SDK/OneSignalSDK/OneSignal_Outcomes" "${PODS_ROOT}/OneSignalXCFramework/iOS_SDK/OneSignalSDK/OneSignal_User" "${PODS_ROOT}/OneSignalXCFramework/iOS_SDK/OneSignalSDK/OneSignal_XCFramework" "${PODS_ROOT}/WireGuardKit/Frameworks" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignalXCFramework/OneSignal" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignalXCFramework/OneSignalCore" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignalXCFramework/OneSignalExtension" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignalXCFramework/OneSignalInAppMessages" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignalXCFramework/OneSignalLiveActivities" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignalXCFramework/OneSignalLocation" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignalXCFramework/OneSignalNotifications" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignalXCFramework/OneSignalOSCore" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignalXCFramework/OneSignalOutcomes" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignalXCFramework/OneSignalUser"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
GCC_WARN_64_TO_32_BIT_CONVERSION = NO
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/OpenVPNAdapter/OpenVPNAdapter.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/WireGuardKit/WireGuardKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/mail_launcher/mail_launcher.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/openvpn_dart/openvpn_dart.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/wireguard_dart/wireguard_dart.framework/Headers" "${PODS_XCFRAMEWORKS_BUILD_DIR}/WireGuardKit/Headers" "${PODS_TARGET_SRCROOT}/Sources/ASIO/asio/include/**" "${PODS_TARGET_SRCROOT}/Sources/mbedTLS/include/**" "${PODS_TARGET_SRCROOT}/Sources/OpenVPN3/**"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_XCFRAMEWORKS_BUILD_DIR}/WireGuardKit" "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -framework "Foundation" -framework "NetworkExtension" -framework "OneSignalCore" -framework "OneSignalExtension" -framework "OneSignalFramework" -framework "OneSignalInAppMessages" -framework "OneSignalLiveActivities" -framework "OneSignalLocation" -framework "OneSignalNotifications" -framework "OneSignalOSCore" -framework "OneSignalOutcomes" -framework "OneSignalUser" -framework "OpenVPNAdapter" -framework "SystemConfiguration" -framework "UIKit" -framework "WireGuardKit" -framework "mail_launcher" -framework "openvpn_dart" -framework "wireguard_dart"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/Flutter" "-F${PODS_CONFIGURATION_BUILD_DIR}/WireGuardKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/mail_launcher" "-F${PODS_CONFIGURATION_BUILD_DIR}/openvpn_dart" "-F${PODS_CONFIGURATION_BUILD_DIR}/wireguard_dart" "-F${PODS_CONFIGURATION_BUILD_DIR}/OpenVPNAdapter" "-F${PODS_CONFIGURATION_BUILD_DIR}/OneSignalXCFramework"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
