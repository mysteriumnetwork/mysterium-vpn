    "version": "0.2.0",
    "configurations": [
        {
            "name": "mysterium_vpn production",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_production.dart",
            "args": [
                "--flavor",
                "production",
                "--target",
                "lib/main_production.dart"
            ]
        },
        {
            "name": "mysterium_vpn production (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main_production.dart",
            "args": [
                "--flavor",
                "production",
                "--target",
                "lib/main_production.dart"
            ]
        },
        {
            "name": "mysterium_vpn production (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main_production.dart",
            "args": [
                "--flavor",
                "production",
                "--target",
                "lib/main_production.dart"
            ]
        },
        {
            "name": "mysterium_vpn dev",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_test.dart",
            "args": [
                "--flavor",
                "dev",
                "--target",
                "lib/main_test.dart"
            ]
        },
        {
            "name": "mysterium_vpn dev (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main_test.dart",
            "args": [
                "--flavor",
                "dev",
                "--target",
                "lib/main_test.dart"
            ]
        },
        {
            "name": "mysterium_vpn dev (release mode)",
            "request": "launch",
