{
  "name": "patrol",
  "version": "0.0.1",
  "summary": "Adapter for integration tests using Patrol.",
  "description": "Runs tests that use flutter_test and patrol APIs as native macOS / iOS integration tests.",
  "homepage": "https://leancode.pl",
  "license": {
    "file": "../LICENSE"
  },
  "authors": {
    "Bartek Pacia": "bartek.pacia@leancode.pl"
  },
  "source": {
    "http": "https://github.com/leancodepl/patrol/tree/master/packages/patrol"
  },
  "source_files": [
    "patrol/Sources/patrol/**/*.{swift,h,m}",
    "patrol/Sources/PatrolImpl/**/*.{swift,h,m}",
    "patrol/Sources/HTTPParserC/**/*.{c,h}"
  ],
  "public_header_files": [
    "patrol/Sources/patrol/include/**/*.h",
    "patrol/Sources/HTTPParserC/include/**/*.h"
  ],
  "exclude_files": [
    "patrol/Sources/patrol/include/module.modulemap",
    "patrol/Sources/patrol/include/patrol.h"
  ],
  "ios": {
    "dependencies": {
      "Flutter": [

      ]
    },
    "frameworks": "UIKit"
  },
  "osx": {
    "dependencies": {
      "FlutterMacOS": [

      ]
    },
    "frameworks": "AppKit"
  },
  "platforms": {
    "ios": "13.0",
    "osx": "10.14"
  },
  "weak_frameworks": "XCTest",
  "resource_bundles": {
    "patrol_privacy": [
      "patrol/Sources/PatrolImpl/Resources/PrivacyInfo.xcprivacy"
    ]
  },
  "resources": [
    "patrol/Sources/PatrolImpl/Resources/*.lproj"
  ],
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "i386"
  },
  "swift_versions": "5.0",
  "dependencies": {
    "CocoaAsyncSocket": [
      "~> 7.6"
    ]
  },
  "swift_version": "5.0"
}
